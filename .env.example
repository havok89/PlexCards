# ==============================================================================
# PlexPosters Configuration
# ==============================================================================

# --- PLEX CREDENTIALS (Required) ---
# Your local or remote Plex server URL (e.g., http://192.168.1.100:32400 or http://localhost:32400)
PLEX_URL=http://localhost:32400

# Your Plex Authentication Token (X-Plex-Token)
# Guide to finding your token: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=your_plex_token_here

# Name of your TV library section in Plex (Default is usually "TV Shows" or "TV")
PLEX_TV_LIBRARY=TV Shows


# --- TMDB (The Movie Database) (Required for Still & Metadata Fetching) ---
# Free API key from https://www.themoviedb.org/settings/api (v3 API key or v4 read token)
# Used to fetch high-res episode backdrops, clean logos, and episode data
TMDB_API_KEY=your_tmdb_api_key_here


# --- MEDIUX (Optional) ---
# MediUX API Token if you have an account or beta access (leave blank for public access)
MEDIUX_API_TOKEN=


# --- FANART.TV (Optional) ---
# For pulling extra transparent show logos if TMDB doesn't have a clean logo
FANART_API_KEY=


# --- AI STYLING (Optional) ---
# If you want to use the "✨ Ask AI to Style" button for matching typography to shows
GEMINI_API_KEY=
# Gemini model (default: gemini-3.5-flash-lite with generous 500 requests/day quota)
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=


# --- APP SETTINGS ---
PORT=8080
HOST=0.0.0.0
# Background poll interval in hours (check for new episodes / MediUX updates)
POLL_INTERVAL_HOURS=12

# Test / Dry Run Mode (Default is true: prevents any uploads or edits to your Plex server while testing)
TEST_MODE=true


# --- AUTHENTICATION (Optional) ---
# Enable Plex OAuth sign-in to protect the UI and API (default: false)
ENABLE_AUTH=false

# Optional comma-separated list of Plex usernames or emails allowed to access.
# If left empty, only the Plex Media Server owner is permitted.
ALLOWED_USERS=

# Secret key used for signing session cookies (auto-generated and persisted in DB if left empty)
SECRET_KEY=

